# 客戶版環境變數範本
# 請複製成 .env.client 或填到 Vercel Environment Variables。

# Supabase
DATABASE_URL=postgresql://postgres.xxxxx:[PASSWORD]@aws-xxx.pooler.supabase.com:6543/postgres
PGOPTIONS=-c search_path=public

# 正式部署網址；Vercel 未完成前可以先留空，完成後再補 https://xxxxx.vercel.app 或正式網域
APP_URL=

# 系統安全金鑰；請用 scripts/generate-client-secrets.js 或 openssl 產生
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
WEBHOOK_SECRET=
CRON_SECRET=
INSTALLER_SECRET=

# 客戶 tenant / 專案
CLIENT_TENANT_SLUG=nanako
CLIENT_TENANT_NAME=Life Order 客戶系統
CLIENT_PROJECT_CODE=P01
CLIENT_PROJECT_NAME=人生診斷卡點

# 客戶後台管理員
CLIENT_ADMIN_NAME=Life Order 管理員
CLIENT_ADMIN_EMAIL=nanako.lifeorder@gmail.com
CLIENT_ADMIN_PASSWORD=請填臨時密碼，不要提交到 GitHub

# Google OAuth；Google Cloud 建好 OAuth Client 後再填
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Zoom 目前非必填
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations