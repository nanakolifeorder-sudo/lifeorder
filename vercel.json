{
    "functions":  {
                      "api/*.js":  {
                                       "maxDuration":  30
                                   }
                  },
    "rewrites":  [
                     {
                         "source":  "/booking",
                         "destination":  "/booking.html"
                     },
                     {
                         "source":  "/admin",
                         "destination":  "/admin.html"
                     },
                     {
                         "source":  "/unsubscribe",
                         "destination":  "/unsubscribe.html"
                     }
                 ],
    "crons":  [
                  {
                      "path":  "/api/cron",
                      "schedule":  "0 0 * * *"
                  }
              ]
}